# Copy to /root/.config/swpro-monitoring.env on the server.
# chmod 600 /root/.config/swpro-monitoring.env
# Never commit the production file with real secrets.

SWPRO_MONITOR_DOMAIN=swpro.ru
SWPRO_MONITOR_URL=https://swpro.ru/

# Alert thresholds
SWPRO_ALERT_COOLDOWN_SECONDS=1800
SWPRO_DISK_WARN_PERCENT=80
SWPRO_DISK_CRITICAL_PERCENT=90
SWPRO_INODE_WARN_PERCENT=80
SWPRO_INODE_CRITICAL_PERCENT=90
SWPRO_RAM_WARN_AVAILABLE_PERCENT=20
SWPRO_RAM_CRITICAL_AVAILABLE_PERCENT=10
SWPRO_SWAP_WARN_PERCENT=25
SWPRO_SWAP_CRITICAL_PERCENT=50
SWPRO_LOAD_WARN_PER_CPU=1.5
SWPRO_LOAD_CRITICAL_PER_CPU=3.0
SWPRO_SSL_WARN_DAYS=30
SWPRO_SSL_CRITICAL_DAYS=7
SWPRO_BACKUP_WARN_AGE_HOURS=26
SWPRO_BACKUP_CRITICAL_AGE_HOURS=50
SWPRO_JOURNAL_WINDOW=10 min ago

# Fixed recovery allowlist: nginx, php8.3-fpm, mariadb, swpro-telegram-tunnel
SWPRO_RECOVERY_ENABLED=true

# Optional remote heartbeat push URL. Keep this secret and never commit the real value.
SWPRO_HEARTBEAT_URL=

# Telegram alert destination. Keep the bot token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
